generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// better-auth core models (documented Prisma schema) + KoBo user fields
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid(2))
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // KoBo
  phone                 String?
  campus                String?
  campusEmail           String?
  campusEmailVerifiedAt DateTime?           @db.Timestamptz(3)
  isDemo                Boolean             @default(false)
  // How and until when the student status was verified. Entra tid / "google:<hd>" and oid / sub; unique together (hand SQL index).
  campusVerifiedVia     CampusVerifyMethod?
  campusVerifiedUntil   DateTime?           @db.Timestamptz(3)
  campusIdpTenant       String?
  campusIdpSubject      String?
  // The campus the latest verification proved (id, or a branch's own id). No FK: Campus is reference data (ADR 0016).
  // Written only by applyVerification; the latest verification wins.
  verifiedCampusId      String?

  // Emergency contact: required before a first application; the contact is only messaged when the student consented.
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?
  emergencyContactConsentAt DateTime? @db.Timestamptz(3)
  // The student switched off payment reminders to themselves (the owner can still see the invoice).
  notifyOptOut              Boolean   @default(false)
  // The Syarat/Privasi version this user agreed to, and when.
  termsVersion              String?
  termsAcceptedAt           DateTime? @db.Timestamptz(3)

  sessions              Session[]
  accounts              Account[]
  ownerProfile          OwnerProfile?
  tenancies             Tenancy[]
  visits                Visit[]
  waitlistEntries       WaitlistEntry[]
  rentalApplications    RentalApplication[]
  recordedPayments      Payment[]              @relation("PaymentRecordedBy")
  profileViewsMade      TenantProfileView[]    @relation("ProfileViewOwner")
  profileViewsOfMe      TenantProfileView[]    @relation("ProfileViewTenant")
  studentDocuments      StudentDocument[]
  campusEmailChallenges CampusEmailChallenge[]
  sheeridVerifications  SheerIdVerification[]
  ownerDocuments        OwnerDocument[]

  // Roommate matching (T1)
  matchingProfile      MatchingProfile?
  partnerRequestsSent  PartnerRequest[]      @relation("PartnerRequestFrom")
  partnerRequestsGot   PartnerRequest[]      @relation("PartnerRequestTo")
  partnerConnectionsA  PartnerConnection[]   @relation("PartnerConnectionA")
  partnerConnectionsB  PartnerConnection[]   @relation("PartnerConnectionB")
  partnerMessages      PartnerMessage[]
  connectionReadStates ConnectionReadState[]
  blocksMade           UserBlock[]           @relation("UserBlockBlocker")
  blocksReceived       UserBlock[]           @relation("UserBlockBlocked")
  reportsMade          UserReport[]          @relation("UserReportReporter")
  reportsReceived      UserReport[]          @relation("UserReportReported")
}

enum CampusVerifyMethod {
  EMAIL
  MICROSOFT
  GOOGLE
  KTM
  SHEERID
}

enum SheerIdStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One SheerID verification session (DEV/TEST ONLY: see sheerIdEnv; refused in production until the legal gate in
/// .orchestration/web-research/all-campus-verification/sheerid-implementation.md is green). Holds no personal data:
/// SheerID collects it on its hosted form; KoBo keeps only the opaque verificationId and the outcome.
model SheerIdVerification {
  id             String        @id @default(cuid(2))
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationId String        @unique
  // No FK: Campus is reference data (ADR 0016).
  campusId       String?
  status         SheerIdStatus @default(PENDING)
  lastStep       String?
  errorIds       String[]      @default([])
  consentVersion String
  consentAt      DateTime      @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?     @db.Timestamptz(3)
  purgedAt       DateTime?     @db.Timestamptz(3)

  @@index([userId, createdAt])
}

enum StudentDocumentKind {
  KTM
}

enum StudentDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudentDocument {
  id                String                @id @default(cuid(2))
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No FK: Campus is reference data (ADR 0016).
  campusId          String?
  kind              StudentDocumentKind   @default(KTM)
  key               String                @unique
  contentType       String
  status            StudentDocumentStatus @default(PENDING)
  nim               String?
  nameOnCard        String?
  validUntil        DateTime?             @db.Date
  // Typed by the student; the reviewer decides validUntil.
  claimedValidUntil DateTime?             @db.Date
  program           String?
  reviewer          String?
  reason            String?
  consentAt         DateTime              @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  decidedAt         DateTime?             @db.Timestamptz(3)
  deleteAfter       DateTime?             @db.Timestamptz(3)
  deletedAt         DateTime?             @db.Timestamptz(3)

  // Hand-written in the migration: unique ("userId") WHERE status = 'PENDING' AND "deletedAt" IS NULL.
  @@index([status, createdAt])
  @@index([deleteAfter])
  @@index([userId, deletedAt, createdAt])
}

model CampusEmailChallenge {
  id         String    @id @default(cuid(2))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// KoBo domain
// ---------------------------------------------------------------------------

enum KosGender {
  CAMPUR
  PUTRA
  PUTRI
}

enum ElectricityType {
  INCLUDED
  TOKEN
}

enum Occupancy {
  VACANT
  BOOKED
  OCCUPIED
}

enum TenancyStatus {
  PENDING
  ACTIVE
  ENDED
}

enum RentalApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum PaymentProvider {
  MOCK
  MANUAL
  XENDIT
}

enum PaymentStatus {
  CREATING
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum GatewayFeeBearer {
  PLATFORM
  OWNER
  TENANT
}

enum ManualPaymentMethod {
  CASH
  BANK_TRANSFER
}

enum XenditOnboardingStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  RESTRICTED
}

enum PaymentWebhookResult {
  RECEIVED
  APPLIED
  IGNORED
  REJECTED
  FAILED
}

enum PaymentRefundStatus {
  PENDING
  SUBMITTED
  SUCCEEDED
  FAILED
}

enum VisitSlot {
  PAGI
  SIANG
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  FULFILLED
  EXPIRED
  DECLINED
  LEFT
  REMOVED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Campus {
  id                  String   @id @default(cuid(2))
  name                String
  shortName           String
  city                String
  lat                 Float
  lng                 Float
  emailDomains        String[]
  // Curated student mail domains (exact match; also matched against a Google hd) and Microsoft Entra tenant ids.
  studentEmailDomains String[] @default([])
  entraTenantIds      String[] @default([])

  // Nationwide catalogue fields (null on the hand-seeded rows). Rows loaded by `catalog:import` carry dataVersion.
  pddiktiId      String?
  osmId          String?
  wikidataId     String?
  kind           String?
  parentId       String?
  desaCode       String?
  gateLat        Float?
  gateLng        Float?
  coordMethod    String?
  verifiedAt     DateTime? @db.Timestamptz(3)
  website        String?
  aliases        String[]
  dataVersion    String?
  // Where an imported row comes from and under which licence; derivedFromOsm marks rows that fall under the ODbL (D3).
  source         String?
  licence        String?
  derivedFromOsm Boolean   @default(false)

  kos Kos[]

  @@index([lat, lng])
  @@index([desaCode])
}

model OwnerProfile {
  id                     String                  @id @default(cuid(2))
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                    String?
  // LEGACY: not read anymore; dropped in a later release
  verified               Boolean                 @default(false)
  responseRate           String?
  memberSince            DateTime                @default(now()) @db.Timestamptz(3)
  xenditSubaccountId     String?                 @unique
  xenditOnboardingStatus XenditOnboardingStatus  @default(NOT_STARTED)
  xenditVerifiedAt       DateTime?               @db.Timestamptz(3)
  // Set when KoBo approves a new owner (scripts/approve-owner.ts or OWNER_AUTO_APPROVE). Until then the owner's kos are
  // visible only to the owner. Not the `verified` badge flag, which stays hidden in the UI.
  approvedAt             DateTime?               @db.Timestamptz(3)
  // Self-declared: PEMILIK, PENGELOLA_KUASA (manager with a power of attorney) or LAINNYA. Not verified; a document badge is manual.
  ownershipType          String?
  ownershipDeclaredAt    DateTime?               @db.Timestamptz(3)
  verificationStatus     OwnerVerificationStatus @default(BELUM_KIRIM)
  verificationReason     String?
  verificationAttempts   Int                     @default(0)

  kos Kos[]
}

enum OwnerVerificationStatus {
  BELUM_KIRIM
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum OwnerDocumentKind {
  KTP
  SHM
  SHGB
  AJB
  GIRIK
  SPPT_PBB
  SURAT_KUASA
  SURAT_KETERANGAN
}

enum OwnerDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model OwnerDocument {
  id          String              @id @default(cuid(2))
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        OwnerDocumentKind
  key         String              @unique
  contentType String
  status      OwnerDocumentStatus @default(PENDING)
  consentAt   DateTime            @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?           @db.Timestamptz(3)
  reviewer    String?
  reason      String?
  deleteAfter DateTime?           @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)

  @@index([userId, status])
  @@index([deleteAfter])
}

/// Campuses (and their branches, via parentId) whose students get "Diskon Kampus Mitra". App table, edited by CLI.
model CampusAffiliation {
  id        String   @id @default(cuid(2))
  // No FK: Campus is reference data (ADR 0016).
  campusId  String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Kos {
  id       String       @id @default(cuid(2))
  slug     String       @unique
  name     String
  gender   KosGender
  address  String
  district String
  city     String
  lat      Float
  lng      Float
  ownerId  String
  owner    OwnerProfile @relation(fields: [ownerId], references: [id])

  electricityType       ElectricityType
  privateAmenities      String[]
  sharedAmenities       String[]
  studentDiscountAmount Int             @default(0)
  applicationFee        Int             @default(25000)

  // Building facts and structured facilities (Kamar / Gedung scopes). privateAmenities / sharedAmenities stay the flat
  // search index and are rewritten from `facilities` on every owner write. Null facilities: legacy rows, read from the arrays.
  floors         Int?
  yearBuilt      Int?
  buildingAreaM2 Int?
  facilities     Json?

  // Written on create / location edit only. Everything else (rating, price, rooms) is computed on read.
  nearestCampusId     String?
  nearestCampus       Campus? @relation(fields: [nearestCampusId], references: [id])
  nearestCampusMeters Int?

  // Finest Region code the pin resolved to (4 segments for a desa/kelurahan, 3 when only the kecamatan is known) and how
  // sure we are: desa | kecamatan | nearest | sea_fallback. Written on create and when the point moves.
  desaCode         String?
  regionConfidence String?

  // Set instead of deleting once the kos ever had a tenancy: it disappears from the marketplace, its paid history stays.
  archivedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  rooms                Room[]
  sharedShortlistItems SharedShortlistItem[]
  rules                HouseRule[]
  pois                 Poi[]
  places               KosPlace[]
  ownerPlaces          OwnerPlace[]
  overlays             PlaceOverlay[]
  images               KosImage[]
  visits               Visit[]
  waitlist             WaitlistEntry[]

  @@index([ownerId])
  @@index([desaCode])
}

model Room {
  id                    String    @id @default(cuid(2))
  kosId                 String
  kos                   Kos       @relation(fields: [kosId], references: [id], onDelete: Cascade)
  roomNumber            String
  floor                 Int
  type                  String
  size                  String
  bedType               String
  priceMonthly          Int
  // People the room fits (1..4, hand-SQL CHECK). 1 means never offered as shareable; the owner sets 2+ to appear in "Cari kos bersama".
  maxOccupants          Int       @default(1)
  // Optional price per person when the room is shared (CHECK > 0); shown as "per orang".
  pricePerPersonMonthly Int?
  occupancy             Occupancy @default(VACANT)
  // Same rule as Kos.archivedAt: a room with tenancy history is archived, never deleted.
  archivedAt            DateTime? @db.Timestamptz(3)

  tenancies          Tenancy[]
  waitlistOffers     WaitlistEntry[]
  rentalApplications RentalApplication[]

  @@unique([kosId, roomNumber])
}

model Tenancy {
  id                String        @id @default(cuid(2))
  roomId            String
  room              Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  status            TenancyStatus
  startDate         DateTime      @db.Timestamptz(3)
  durationMonths    Int
  /// Rent per month agreed at approval (A-006); null on rows from before the column.
  agreedMonthlyRent Int?
  expiresAt         DateTime?     @db.Timestamptz(3)
  endedAt           DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  invoices          Invoice[]
  review            Review?
  rentalApplication RentalApplication?

  @@index([roomId])
  @@index([userId])
}

model RentalApplication {
  id             String                  @id @default(cuid(2))
  roomId         String
  room           Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         RentalApplicationStatus @default(PENDING)
  startDate      DateTime                @db.Date
  durationMonths Int
  occupation     String?
  program        String?
  semester       Int?
  note           String?
  tenancyId      String?                 @unique
  tenancy        Tenancy?                @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  waitlistEntry  WaitlistEntry?
  decidedAt      DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  @@index([roomId, status, createdAt])
  @@index([userId, createdAt])
}

model Invoice {
  id                    String           @id @default(cuid(2))
  tenancyId             String
  tenancy               Tenancy          @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  periodStart           DateTime         @db.Date
  dueDate               DateTime         @db.Date
  amount                Int
  rentAmount            Int
  discountAmount        Int
  applicationFeeAmount  Int
  ownerReceivableAmount Int
  gatewayFeeBearer      GatewayFeeBearer
  status                InvoiceStatus    @default(UNPAID)

  payments      Payment[]
  notifications NotificationLog[]

  @@index([tenancyId])
  @@index([status, dueDate])
}

model Payment {
  id                       String               @id @default(cuid(2))
  invoiceId                String
  invoice                  Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider                 PaymentProvider
  externalId               String?              @unique
  providerBusinessId       String?
  providerSessionId        String?              @unique
  providerPaymentRequestId String?              @unique
  providerPaymentId        String?              @unique
  providerSplitRuleId      String?
  checkoutUrl              String?
  expiresAt                DateTime?            @db.Timestamptz(3)
  channel                  String?
  failureCode              String?
  manualMethod             ManualPaymentMethod?
  manualReference          String?
  manualNote               String?
  recordedById             String?
  recordedBy               User?                @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  receiptNo                Int                  @unique @default(autoincrement())
  amount                   Int
  status                   PaymentStatus        @default(PENDING)
  paidAt                   DateTime?            @db.Timestamptz(3)
  refundedAt               DateTime?            @db.Timestamptz(3)
  /**
   * Throttle for payment.reconcile: one provider lookup per attempt per 30 seconds.
   */
  lastReconciledAt         DateTime?            @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)

  webhookEvents PaymentWebhookEvent[]
  refund        PaymentRefund?

  @@index([invoiceId])
  @@index([recordedById])
}

model PaymentWebhookEvent {
  id                 String               @id @default(cuid(2))
  provider           PaymentProvider
  fingerprint        String               @unique
  eventType          String
  externalResourceId String
  paymentId          String?
  payment            Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  result             PaymentWebhookResult @default(RECEIVED)
  reason             String?
  metadata           Json?
  processedAt        DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  @@index([provider, externalResourceId])
  @@index([paymentId])
  @@index([result, createdAt])
}

model PaymentRefund {
  id               String              @id @default(cuid(2))
  paymentId        String              @unique
  payment          Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  referenceId      String              @unique
  amount           Int
  reason           String
  providerRefundId String?             @unique
  status           PaymentRefundStatus @default(PENDING)
  attempts         Int                 @default(0)
  nextAttemptAt    DateTime            @default(now()) @db.Timestamptz(3)
  lastError        String?
  submittedAt      DateTime?           @db.Timestamptz(3)
  succeededAt      DateTime?           @db.Timestamptz(3)
  failedAt         DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

model Review {
  id              String    @id @default(cuid(2))
  tenancyId       String    @unique
  tenancy         Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  rating          Int
  cleanliness     Int?
  wifi            Int?
  ownerRating     Int?
  quietness       Int?
  comment         String
  // Snapshot of the author's campus-email verification at write time; never recomputed.
  verifiedStudent Boolean   @default(false)
  ownerReply      String?
  ownerReplyAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
}

model HouseRule {
  id            String   @id @default(cuid(2))
  kosId         String
  kos           Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  tier          Int
  categoryTitle String
  rules         String[]
  penaltyAmount Int?
  penaltyClause String?

  @@index([kosId])
}

model Poi {
  id             String @id @default(cuid(2))
  kosId          String
  kos            Kos    @relation(fields: [kosId], references: [id], onDelete: Cascade)
  category       String
  name           String
  distanceMeters Int
  walkMinutes    Int
  description    String

  @@index([kosId])
}

model KosImage {
  id     String  @id @default(cuid(2))
  kosId  String
  kos    Kos     @relation(fields: [kosId], references: [id], onDelete: Cascade)
  // Uploaded photos use `key` (R2 object key); seeded photos keep an external `url`.
  key    String?
  url    String?
  order  Int
  width  Int?
  height Int?

  @@index([kosId])
}

model Visit {
  id        String      @id @default(cuid(2))
  kosId     String
  kos       Kos         @relation(fields: [kosId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  timeSlot  VisitSlot
  status    VisitStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([kosId])
  @@index([userId])
}

model WaitlistEntry {
  id             String             @id @default(cuid(2))
  kosId          String
  kos            Kos                @relation(fields: [kosId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = any room type
  roomType       String?
  status         WaitlistStatus     @default(WAITING)
  offeredRoomId  String?
  offeredRoom    Room?              @relation(fields: [offeredRoomId], references: [id], onDelete: SetNull)
  offerExpiresAt DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?          @db.Timestamptz(3)
  applicationId  String?            @unique
  application    RentalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Hand-written in the migration: partial index (kosId, createdAt) WHERE status IN ('WAITING','OFFERED').
  @@index([kosId, status, createdAt])
  @@index([userId])
}

/// Audit row for every time an owner opens a tenant's profile (UU PDP: who looked at what, when).
model TenantProfileView {
  id           String   @id @default(cuid(2))
  ownerUserId  String
  owner        User     @relation("ProfileViewOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  tenantUserId String
  tenant       User     @relation("ProfileViewTenant", fields: [tenantUserId], references: [id], onDelete: Cascade)
  kosId        String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantUserId, createdAt])
}

/// One row per payment reminder decision. The unique key makes a rescan harmless: an invoice gets each kind once per channel.
/// kind: REMINDER_H7 | REMINDER_H3 | REMINDER_H1 | EMERGENCY_CONTACT. channel: EMAIL | WHATSAPP. status: SENT | FAILED.
/// recipient is a role label (PENYEWA, KONTAK_DARURAT), never a phone number or address.
model NotificationLog {
  id        String   @id @default(cuid(2))
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String
  channel   String
  recipient String
  status    String
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([invoiceId, kind, channel])
  @@index([invoiceId])
}

model EmailOutbox {
  id            String       @id @default(cuid(2))
  to            String
  template      String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Location catalogue. Region, PlaceCatalog and CatalogMeta are read-only reference data loaded by `catalog:import`
// (ADR 0016): no foreign keys to app tables, so a TRUNCATE ... CASCADE of the app never reaches them, and resetDb skips them.
// ---------------------------------------------------------------------------

model Region {
  code              String  @id
  level             Int
  name              String
  kind              String
  parentCode        String?
  lat               Float
  lng               Float
  minLat            Float?
  maxLat            Float?
  minLng            Float?
  maxLng            Float?
  postalCode        String?
  // GeoJSON MultiPolygon coordinates ([lng, lat]); provinsi, kab/kota and kecamatan only.
  polygon           Json?
  polygonProvenance String?
  dataVersion       String

  @@index([level, parentCode])
  @@index([level, minLat, maxLat])
  @@index([name])
}

model PlaceCatalog {
  id             String    @id
  source         String
  sourceId       String
  category       String
  subcategory    String?
  name           String
  nameAlt        String?
  brand          String?
  lat            Float
  lng            Float
  cell           String
  desaCode       String?
  hoursRaw       String?
  website        String?
  osmType        String?
  osmId          BigInt?
  score          Int
  licence        String
  attribution    String
  derivedFromOsm Boolean
  firstSeen      DateTime? @db.Timestamptz(3)
  updatedAt      DateTime? @db.Timestamptz(3)
  isHidden       Boolean   @default(false)
  dataVersion    String

  @@unique([source, sourceId])
  @@index([category, cell])
  @@index([cell])
  @@index([source])
  @@index([desaCode])
}

model CatalogMeta {
  version       String   @id
  dataset       String
  status        String
  rowCount      Int
  checksum      String?
  loadedAt      DateTime @default(now()) @db.Timestamptz(3)
  sourceSummary Json?
}

// A snapshot of "what is near this kos": references to PlaceCatalog / OwnerPlace rows, never copies of their fields.
model KosPlace {
  id             String  @id @default(cuid(2))
  kosId          String
  kos            Kos     @relation(fields: [kosId], references: [id], onDelete: Cascade)
  // PlaceCatalog.id or OwnerPlace.id (no foreign key on purpose: the catalogue is reloaded by version).
  placeId        String
  category       String
  distanceM      Int
  mode           String
  rank           Int
  catalogVersion String
  hiddenByOwner  Boolean @default(false)
  addedByOwner   Boolean @default(false)
  sourceLabel    String

  @@unique([kosId, placeId])
  @@index([kosId])
}

// An owner's decision about a place, kept across snapshot refreshes (the snapshot is rebuilt, the overlay is not).
model PlaceOverlay {
  id        String   @id @default(cuid(2))
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  placeId   String
  override  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([kosId, placeId, override])
  @@index([kosId])
}

// A place an owner adds. Pending until KoBo approves it; never public before, never carries contact details.
model OwnerPlace {
  id        String   @id @default(cuid(2))
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  name      String
  category  String
  lat       Float
  lng       Float
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([kosId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Roommate matching (T1, ADR 0022). App tables only. No FK to Campus (ADR 0016): campusId is a plain string.
// Hand SQL (migration 20261122100000_matching): one PENDING request per unordered pair, one live connection per pair,
// userAId < userBId, CHECKs on ranges. Prisma cannot express those, so db:diff does not see them.
// ---------------------------------------------------------------------------

enum MatchGender {
  LAKI_LAKI
  PEREMPUAN
}

enum SleepPref {
  AWAL
  NORMAL
  MALAM
  BEBAS
}

enum TidinessPref {
  SANTAI
  CUKUP
  RAPI
  BEBAS
}

enum SmokingPref {
  MEROKOK
  TIDAK_MEROKOK_TOLERAN
  TIDAK_MAU_PEROKOK
  BEBAS
}

enum GuestsPref {
  JARANG
  KADANG
  SERING
  BEBAS
}

enum NoisePref {
  TENANG
  SEDANG
  RAMAI
  BEBAS
}

enum SocialPref {
  INTROVERT
  SEIMBANG
  EKSTROVERT
  BEBAS
}

enum StudyPref {
  DI_KAMAR
  CAMPUR
  DI_LUAR
  BEBAS
}

enum AcPref {
  SELALU
  MALAM_SAJA
  TANPA_AC
  BEBAS
}

enum ExpensesPref {
  PATUNGAN
  SEBAGIAN
  TERPISAH
  BEBAS
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum PartnerEndReason {
  ENDED_BY_USER
  BLOCKED
  PROFILE_DELETED
  SELESAI
}

enum ReportReason {
  PELECEHAN
  SPAM_PENIPUAN
  PROFIL_PALSU
  KONTEN_TIDAK_PANTAS
  LAINNYA
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model MatchingProfile {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  displayName String
  intro       String      @default("")
  // Self-declared, shown only inside matching. Matching is same-gender only.
  gender      MatchGender
  // Shown as an age band, never exactly. Under 18 is refused.
  birthYear   Int
  // Copied from User.verifiedCampusId when the profile is saved. No FK (ADR 0016).
  campusId    String?

  // Visible in discover only while active, not paused, not hidden by reports, and seen within 30 days.
  active            Boolean   @default(false)
  // "Sudah dapat teman sekamar": pauses the profile without deleting it.
  pausedAt          DateTime? @db.Timestamptz(3)
  // Switches off matching emails (requests, accepts, digests) for this user.
  emailOptOut       Boolean   @default(false)
  lastActiveAt      DateTime  @default(now()) @db.Timestamptz(3)
  // Set when 3 OPEN reports from distinct reporters accumulate; cleared by a reviewer decision.
  hiddenByReportsAt DateTime? @db.Timestamptz(3)

  // Preferences
  budgetMin      Int
  budgetMax      Int
  anchorLat      Float
  anchorLng      Float
  anchorLabel    String
  radiusKm       Int       @default(3)
  moveInDate     DateTime  @db.Date
  durationMonths Int       @default(12)
  kosType        KosGender @default(CAMPUR)
  roomShare      Int       @default(2)

  // Lifestyle (9 fields, each with BEBAS = no preference)
  sleep    SleepPref    @default(BEBAS)
  tidiness TidinessPref @default(BEBAS)
  smoking  SmokingPref
  guests   GuestsPref   @default(BEBAS)
  noise    NoisePref    @default(BEBAS)
  social   SocialPref   @default(BEBAS)
  study    StudyPref    @default(BEBAS)
  ac       AcPref       @default(BEBAS)
  expenses ExpensesPref @default(BEBAS)

  @@index([active, lastActiveAt])
}

model PartnerRequest {
  id         String               @id @default(cuid(2))
  fromUserId String
  from       User                 @relation("PartnerRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User                 @relation("PartnerRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  message    String               @default("")
  status     PartnerRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime             @db.Timestamptz(3)
  decidedAt  DateTime?            @db.Timestamptz(3)

  connection PartnerConnection?

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([status, expiresAt])
}

model PartnerConnection {
  id        String            @id @default(cuid(2))
  // Ordered pair (hand-SQL CHECK userAId < userBId) so a pair has one canonical row.
  userAId   String
  userA     User              @relation("PartnerConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User              @relation("PartnerConnectionB", fields: [userBId], references: [id], onDelete: Cascade)
  requestId String            @unique
  request   PartnerRequest    @relation(fields: [requestId], references: [id])
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?         @db.Timestamptz(3)
  endedById String?
  endReason PartnerEndReason?

  messages   PartnerMessage[]
  readStates ConnectionReadState[]
  shortlist  SharedShortlistItem[]

  @@index([userAId, endedAt])
  @@index([userBId, endedAt])
}

model PartnerMessage {
  id           String            @id @default(cuid(2))
  connectionId String
  connection   PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body         String
  // The sender confirmed a contact-info warning (phone, email, link) before sending; kept for moderation.
  hadContact   Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([connectionId, createdAt])
  @@index([senderId])
}

model ConnectionReadState {
  connectionId String
  connection   PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt   DateTime          @default(now()) @db.Timestamptz(3)
  // Last time the 6-hour "pesan baru" digest email was sent to this user for this connection.
  lastDigestAt DateTime?         @db.Timestamptz(3)

  @@id([connectionId, userId])
}

model SharedShortlistItem {
  id           String            @id @default(cuid(2))
  connectionId String
  connection   PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kosId        String
  kos          Kos               @relation(fields: [kosId], references: [id], onDelete: Cascade)
  addedById    String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([connectionId, kosId])
}

model UserBlock {
  id        String   @id @default(cuid(2))
  blockerId String
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id            String       @id @default(cuid(2))
  reporterId    String
  reporter      User         @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId    String
  reported      User         @relation("UserReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason        ReportReason
  detail        String       @default("")
  // Plain ids (no FK): the connection or message may be purged, the report stays.
  connectionId  String?
  messageId     String?
  // The last 50 messages at report time (S4), so a purge does not destroy the evidence.
  snapshot      Json?
  // Counts toward the 3-reporter auto-hide only when the reporter had a request or connection with the target (S2).
  countsForHide Boolean      @default(false)
  status        ReportStatus @default(OPEN)
  reviewer      String?
  decidedAt     DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([reportedId, status])
}
