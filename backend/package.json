{
  "name": "@kobo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seedCli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@hono/node-server": "^2.1.3",
    "@kobo/shared": "*",
    "@prisma/adapter-pg": ">=7.5.0 <8",
    "@prisma/client": ">=7.5.0 <8",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.7",
    "croner": "^10.0.1",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "prisma": ">=7.5.0 <8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  }
}
