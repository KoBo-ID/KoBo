{
  "name": "@kobo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seedCli.ts",
    "email:smoke": "tsx scripts/email-smoke.ts",
    "refunds:admin": "tsx scripts/refund-admin.ts",
    "owners:approve": "tsx scripts/approve-owner.ts",
    "places:approve": "tsx scripts/approve-places.ts",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:rollback": "tsx scripts/catalog-rollback.ts",
    "catalog:backfill": "tsx scripts/catalog-backfill.ts",
    "catalog:golden": "tsx scripts/catalog-golden.ts",
    "catalog:perf": "tsx scripts/catalog-perf.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@hono/node-server": "^2.1.8",
    "@kobo/shared": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@trpc/server": "^11.28.1",
    "better-auth": "^1.7.23",
    "croner": "^11.0.0",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
