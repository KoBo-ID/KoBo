# Copy to .env (git-ignored). Matches backend/docker-compose.yml.
DATABASE_URL=postgresql://kobo:kobo@localhost:5434/kobo
TEST_DATABASE_URL=postgresql://kobo:kobo@localhost:5433/kobo_test
SHADOW_DATABASE_URL=postgresql://kobo:kobo@localhost:5433/kobo_shadow
PORT=3000

# Auth (better-auth). BETTER_AUTH_URL is the origin the BROWSER uses for the site: every email link (verify, reset,
# campus email, receipts, waitlist offers) points at it, and sign-in/up POSTs must come from it (CSRF origin check).
# Production: the public site origin (https://<domain>), the one the browser uses; no trailing slash, no /api. The server refuses to start in production with an http:// or
# localhost value (ALLOW_INSECURE_AUTH_URL=1 opts out; e2e / local production runs only).
# Generate the secret with: openssl rand -base64 32. Production refuses a secret shorter than 32 characters.
# Rotating it signs every user out.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# e2e / local production-mode runs only: accept an http://localhost BETTER_AUTH_URL with NODE_ENV=production.
# Never set on a real server.
ALLOW_INSECURE_AUTH_URL=
# Optional, comma-separated: extra origins allowed to sign in (e.g. Vercel preview domains). Dev always allows
# http://localhost:5173.
TRUSTED_ORIGINS=
# Optional, comma-separated: headers the client IP is read from for auth rate limiting. Default in production is
# cf-connecting-ip (Cloudflare Tunnel), so leave it unset on the VPS. Only a deployment NOT behind Cloudflare needs an
# override. If no IP resolves, all clients share one rate-limit bucket (e.g. 3 verification resends per minute for everyone).
AUTH_IP_HEADERS=

# Demo isolation: real accounts cannot apply to, queue for or book surveys at demo-owned kos, and the shared demo accounts
# cannot do so at kos owned by real owners (backend/src/demoIsolation.ts). Production default: ON. Set DEMO_ISOLATION=0 to
# turn it off (the e2e servers do). Dev and tests default to off; set DEMO_ISOLATION=1 to try it locally.
DEMO_ISOLATION=

# Mahasiswa-only gate: a new rental start needs a verified student (backend/src/studentGate.ts). Production default: ON.
# Set REQUIRE_STUDENT_VERIFICATION=0 to turn it off; elsewhere it is off unless set to 1.
REQUIRE_STUDENT_VERIFICATION=

# Optional: owners whose email matches skip the manual owner-approval wait (team and demos). Comma-separated exact emails
# or "@domain" suffixes. Leave empty in production unless you mean it.
OWNER_AUTO_APPROVE=

# Google sign-in ("Lanjutkan dengan Google"). Optional: set BOTH or NEITHER (one alone makes the server refuse to start).
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application). Authorized redirect URIs:
#   local   http://localhost:3000/api/auth/callback/google   (BETTER_AUTH_URL above; add http://localhost:5173/api/auth/callback/google
#           only if you run Vite with BETTER_AUTH_URL=http://localhost:5173, the proxy forwards /api)
#   prod    https://<BETTER_AUTH_URL host>/api/auth/callback/google   (the Vercel/custom domain, not the Railway URL)
# Authorized JavaScript origins: the same origins without the path. Scopes: openid, email, profile (default).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The same Google client also powers "verifikasi dengan akun kampus" (Google Workspace, matched on the hd claim). Add its redirect URIs:
#   http://localhost:3000/api/auth/campus-idp/callback   and   http://localhost:5173/api/auth/campus-idp/callback   (plus the prod origin)

# Microsoft campus-account verification (Entra ID). Optional: set BOTH or NEITHER. Same redirect URIs as above:
#   http://localhost:3000/api/auth/campus-idp/callback
#   http://localhost:5173/api/auth/campus-idp/callback   (plus https://<BETTER_AUTH_URL host>/api/auth/campus-idp/callback in prod)
# Register the app as MULTI-TENANT ("Accounts in any organizational directory") in a tenant KoBo owns, never inside a campus tenant.
# It only reads tid + oid from the ID token; there is no email scope and no Graph access.
CAMPUS_MS_CLIENT_ID=
CAMPUS_MS_CLIENT_SECRET=

# SheerID student verification: DEV/TEST ONLY (ADR 0019). Off unless SHEERID_ENABLED=1, and the server refuses to start
# with it in production. Use a MySheerID program in Test Mode only (fake names, SheerID's sample documents), never real
# students' data: see .orchestration/web-research/all-campus-verification/sheerid-implementation.md for the legal gate.
# Program redirect URL (set in MySheerID): http://localhost:5173/profile?sheerid=done . Webhook (optional, needs a public
# https URL, e.g. a tunnel): <origin>/api/webhooks/sheerid with the Secret Token below; without it the return page polls.
SHEERID_ENABLED=
SHEERID_PROGRAM_ID=
SHEERID_CLIENT_ID=
SHEERID_CLIENT_SECRET=
SHEERID_WEBHOOK_SECRET=

# Email. In development, unset RESEND_API_KEY makes the server log each email (and its link) to the console. In production
# the server refuses to start without it (links are bearer tokens); ALLOW_CONSOLE_EMAIL=1 is for e2e and demo only.
# EMAIL_FROM must be on a domain verified in Resend: onboarding@resend.dev only delivers to the Resend account owner
# and lands in spam.
RESEND_API_KEY=
ALLOW_CONSOLE_EMAIL=
EMAIL_FROM=KoBo <no-reply@example.com>
# Optional: Reply-To address (a mailbox someone reads, e.g. halo@example.com).
EMAIL_REPLY_TO=

# E2E (npm run e2e): dedicated database, truncated and reseeded on every run. Create once:
#   psql -h localhost -p 5433 -U kobo -d postgres -c 'CREATE DATABASE kobo_e2e'
# Needs `npm run build` first. Override with E2E_DATABASE_URL / E2E_PORT (default 3100).
# BASE_URL=https://... runs the suite against a live site with no local server (e2e:postdeploy).

# Payments. `mock` is safe for local development and demo accounts. Use `xendit` only with Test Mode credentials
# until the live-money release gate is complete. Xendit credentials stay server-side.
PAYMENT_PROVIDER=mock
# Test/e2e only. Production refuses PAYMENT_PROVIDER=mock unless this explicit opt-in is present.
# Never enable on a real deployment: mock attempts do not represent money received.
ALLOW_MOCK_PAYMENTS=
# Test/e2e only. Mounts /api/__e2e/* and a fake Xendit provider for non-demo users. Refused unless
# PAYMENT_PROVIDER=mock, a loopback DATABASE_URL and, in production mode, ALLOW_MOCK_PAYMENTS=1.
ALLOW_E2E_HOOKS=
XENDIT_MODE=test
XENDIT_SECRET_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=
# Local contract tests only. Production refuses this override and always uses https://api.xendit.co.
# Public https origin for payment return URLs when it differs from BETTER_AUTH_URL (Xendit rejects http).
PAYMENT_RETURN_ORIGIN=
XENDIT_API_BASE_URL=
# Required in addition to XENDIT_MODE=live. This is a safety switch, not proof that business/KYC gates passed.
ENABLE_XENDIT_LIVE=

# Place search (free text to a map point). Default: the public OpenStreetMap Nominatim, which allows 1 request per second
# and requires an identifying User-Agent; KoBo caches every answer and calls it only when a search is submitted.
# For real traffic point GEOCODER_URL at a self-hosted or commercial Nominatim-compatible endpoint. GEOCODER=off disables it.
GEOCODER=
GEOCODER_URL=
GEOCODER_CONTACT=

# Photos (Cloudflare R2, S3-compatible). Leave ALL of these unset in dev/e2e: the server then uses an in-memory
# fake storage and a dev-only /api/dev-uploads route (logged at startup, never mounted when R2 is configured).
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
# Public URL prefix of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=
# Private bucket for KTM photos (keys under private/). Set all three or none (a partial set is an error). Production
# refuses R2_PRIVATE_BUCKET equal to R2_PUBLIC_BUCKET. It shares R2_ENDPOINT, has no public access and its own API token
# scoped to that bucket only. In production every R2_PUBLIC_* and R2_PRIVATE_* variable must be set (ALLOW_FAKE_STORAGE=1
# is e2e only). Without the private trio in dev, private uploads (KTM) are disabled.
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# Worker liveness pings (healthchecks.io). Optional. Base URL of the healthchecks.io ping endpoint, no trailing slash:
# each background worker pings <base>/<worker-slug> after a successful run, so a stalled worker raises an alert. Unset = no
# pings (dev). The deploy-level HEALTHCHECKS_URL used by the nightly backup is a separate variable (see deploy/RUNBOOK.md).
HEALTHCHECKS_PING_BASE=
# Optional: release label (e.g. the image tag) reported by /api/health. Unset = omitted.
APP_VERSION=

# Location catalogue (regions, nationwide campuses, places). Loaded by `npm run catalog:import -w backend`, a one-off job.
# Comma-separated operator emails allowed to call catalog.status.
CATALOG_ADMIN_EMAILS=
# Data job only (notes/data-gathering/scripts): the project mailbox put in the User-Agent of data downloads. Never a personal email.
DATA_CONTACT=

# Emergency contact (with consent) and the current Syarat are required before a first application. Default: on in production, off elsewhere.
# REQUIRE_PROFILE_CONSENTS=1
