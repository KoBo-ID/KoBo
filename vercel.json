{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kobo-production-d07e.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|assets/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
